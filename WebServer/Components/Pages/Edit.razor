@page "/edit"
@inherits Redirect

<PageTitle>Edit</PageTitle>

<div class="edit-wrapper">

	<div class="container">

		<!-- Resume Name -->
		<div class="resumeName">
			<label>Resume Name:</label>
			<input type="text" id="resumeTitle" value="Resume1">

		</div>

		<!-- Filters -->
		<div class="filters">
			<h3>Set Filters</h3>

			<select id="location" @bind=selectedLocation>
				<option value="">Filter Location</option>
				<option value="Sub10Miles">&lt;10 miles</option>
				<option value="Sub25Miles">&lt;25 miles</option>
				<option value="Sub50Miles">&lt;50 miles</option>
				<option value="Sub100Miles">&lt;100 miles</option>
			</select>

			<select id="salary" @bind=selectedSalary>
				<option value="">Filter Salary</option>
				<option value="Sub20K">&lt;$20,000</option>
				<option value="From20KTo50K">$20,000-$50,000</option>
				<option value="From50KTo80K">$50,000-$80,000</option>
				<option value="Over80K">>$80,000</option>
			</select>

			<select id="experience" @bind=selectedExperience>
				<option value="">Filter Experience</option>
				<option value="Intern">Internship</option>
				<option value="Entry">Entry-Level</option>
				<option value="MidLevel">Mid-Level</option>
				<option value="Senior">Senior Level</option>
			</select>

			<button @onclick=SaveAll>Save All</button>
		</div>

		<!-- Skills Section -->
		<div class="skills">

			<!-- Extracted Skills -->
			<div class="skills-box">
				<h2>Skills Extracted</h2>

				<input type="text" id="skillInput" placeholder="Add skill...">
				<button @onclick=AddSkill>Add</button>

				<div id="skillsList"></div>
			</div>

		</div>

	</div>

</div>

@code {
	/// <summary>
	/// The location option currently selected by the user (null if no selection).
	/// </summary>
	private Location? selectedLocation;
	/// <summary>
	/// The salary option currently selected by the user (null if no selection).
	/// </summary>
	private Salary? selectedSalary;
	/// <summary>
	/// The experience option currently selected by the user (null if no selection).
	/// </summary>
	private Experience? selectedExperience;
	
	private void SaveAll() {
		// TODO: Save selected filters (and resume name?) to DB.
	}

	private void AddSkill() {
		// TODO: Add skill in skills box to DB.
	}

	private enum Location { Sub10Miles, Sub25Miles, Sub50Miles, Sub100Miles }
	private enum Salary { Sub20K, From20KTo50K, From50KTo80K, Over80K }
	private enum Experience { Intern, Entry, MidLevel, Senior }
}