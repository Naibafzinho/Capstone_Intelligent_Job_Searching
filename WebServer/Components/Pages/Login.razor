@page "/login"
@rendermode InteractiveServer
@inject NavigationManager navigationManager
@inject SessionManager sessionManager

<PageTitle>Login</PageTitle>

<!--Outer wrapper to center the login card on the page-->
<div class="login-wrapper">

	<!--Logo display-->
	<img src="resumelogo.png" alt="Logo" class="logo">

	<!--Login card for all elements-->
	<div class="login-card">
		<h1>Welcome back</h1>
		<p class="subtitle">Sign in to your account</p>

		<form @onsubmit=LoginAttempt>
			<!--Username input field-->
			<div class="field">
				<label for="username">Username</label>
				<input type="text" id="username" @bind-value=username placeholder="Enter your username" />
			</div>

			<!--Password input field-->
			<div class="field">
				<label for="password">Password</label>
				<input type="password" id="password" @bind-value=password placeholder="Enter your password" />
			</div>

			<span class="errortext">@errorMessage</span>
		
			<!--Submit button to sign in-->
			<button type="submit">Sign in</button>
		</form>

		<!--Link to send users to sign-up page-->
		<NavLink href="/signup" class="forgot">Don't have an account?</NavLink>

	</div>

</div>

@code {
	/// <summary>
	/// The username currently typed by the user.
	/// </summary>
	private string username = "";
	/// <summary>
	/// The password currently typed by the user.
	/// </summary>
	private string password = "";
	/// <summary>
	/// The currently displayed error message. Blank for no error.
	/// </summary>
	private string errorMessage = "";

	private void LoginAttempt()	{
		bool success = sessionManager.AttemptLogin(username, password);
		if (success) {
			navigationManager.NavigateTo("/upload");
		} else {
			errorMessage = "Invalid username/password. Please try again.";
		}
	}

	// Redirect to home page if authenticated.
	protected override void OnInitialized()	{
		if (sessionManager.IsAuthenticated()) {
			navigationManager.NavigateTo("/");
		}
	}
}