@page "/matches/{targetResumeID}"
@inherits Redirect

<PageTitle>Matches</PageTitle>

<div class="matches-wrapper">
	@foreach (JobListing job in GetResumeJobs(targetResumeID)) {
		<JobCard jobListing=job />
	}
</div>

