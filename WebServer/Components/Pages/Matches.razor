@page "/matches/{targetResumeID}"
@inherits Redirect
@inject HttpClient http

<PageTitle>Matches</PageTitle>

<div class="matches-wrapper">
	@if (loading)
	{
		<p>Loading jobs...</p>
	}
	else if (!string.IsNullOrEmpty(error))
	{
		<p style="color:red">@error</p>
	}
	else
	{
		@foreach (JobListing job in jobListings)
		{
			<JobCard jobListing=job />
		}
	}
</div>

@code {
	[Parameter]
	public string? targetResumeID { get; set; }

	public JobListing[] jobListings { get; set; } = [];

	private bool loading = true;
	private string error = "";

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var response = await http.PostAsJsonAsync(
				"http://localhost:8000/fetch",
				new
				{
					collection_name = "JobPostings",
					filter = new { },
					projection = new { }
				}
			);

			var result = await response.Content.ReadFromJsonAsync<FetchResponse>();

			if (result?.result != null)
			{
				jobListings = result.result.Select(job => new JobListing(
					Title: job.title ?? "No Title",
					CompanyName: job.company ?? "Unknown",
					DatePosted: job.datePosted ?? "",
					OriginalPostingSite: job.domain ?? "",
					OriginalPostingLink: job.url ?? "",

					// ✅ SAFE ARRAYS (FIX)
					Industries: SafeArray(job.industryC),
					ExperienceLevels: SafeArray(job.experienceLevelC),
					EmploymentTypes: SafeArray(job.jobTypeC),
					SalaryRanges: SafeArray(job.salaryRangeC),
					Locations: SafeArray(job.locationC),
					RemoteStatuses: SafeArray(job.remoteC),

					CompanySizes: SafeArray(new string[] { job.companySizeC ?? "" }),

					Description: job.text ?? "No description available"
				)).ToArray();
			}

			loading = false;
		}
		catch (Exception ex)
		{
			error = ex.Message;
			loading = false;
		}
	}

	// =============================
	// SAFE ARRAY HELPER (CRITICAL FIX)
	// =============================
	private string[] SafeArray(string[] arr)
	{
		if (arr == null || arr.Length == 0)
			return new string[] { "" }; // prevents JobCard crash

		return arr;
	}

	// =============================
	// RESPONSE MODELS
	// =============================
	public class FetchResponse
	{
		public List<JobDB> result { get; set; }
	}

	public class JobDB
	{
		public string title { get; set; }
		public string company { get; set; }
		public string datePosted { get; set; }
		public string domain { get; set; }
		public string url { get; set; }
		public string text { get; set; }

		public string[] locationC { get; set; }
		public string[] salaryRangeC { get; set; }
		public string[] jobTypeC { get; set; }
		public string[] industryC { get; set; }
		public string[] experienceLevelC { get; set; }
		public string[] remoteC { get; set; }
		public string companySizeC { get; set; }
	}
}