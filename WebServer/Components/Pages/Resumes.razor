@page "/resumes"
@inherits Redirect
@implements IDisposable

@inject ResumeDisplayer resumeDisplayer

<PageTitle>Resumes</PageTitle>

<div class="page-header">
	<h1>My Resumes</h1>
</div>

<div class="resumes-wrapper">
	<!--Resume container to hold each resume-->
	<div class="resumeContainer">
		@foreach (Resume resume in resumeDisplayer.GetResumes()) { <ResumeBox Name=@resume.Filename /> }
	</div>
</div>

@code {
	protected override void OnInitialized() => resumeDisplayer.ResumeListUpdated += Rerender;
	public void Dispose() => resumeDisplayer.ResumeListUpdated -= Rerender;

	/// <summary>
	/// Re-renders this component if resume list is updated.
	/// </summary>
	private void Rerender() {
		_ = InvokeAsync(StateHasChanged);
	}
}