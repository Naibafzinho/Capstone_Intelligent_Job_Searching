@page "/signup"
@inherits Redirect

@inject NavigationManager navigationManager
@inject SessionManager sessionManager

<PageTitle>Signup</PageTitle>

<!--Outer wrapper to center the signup card on the page-->
<div class="login-wrapper">
		
	<!--Logo display-->
	<img src="resumelogo.png" alt="Logo" class="logo">

	<!--Login card for all elements-->
	<div class="login-card">
		<h1>Welcome</h1>
		<p class="subtitle">Create your account</p>
		<form @onsubmit=SignupAttempt @onsubmit:preventDefault>
			<!--Email input field-->
			<div class="field">
				<label for="email">Email</label>
				<input type="email" id="email" @bind-value=email placeholder="Enter your email" />
			</div>

			<!--Username input field-->
			<div class="field">
				<label for="username">Username</label>
				<input type="text" id="username" @bind-value=username placeholder="Enter your username" />
			</div>

			<!--Password input field-->
			<div class="field">
				<label for="password">Password</label>
				<input type="password" id="password" @bind-value=password placeholder="Enter your password" />
			</div>

			<span class="errortext">@errorMessage</span>

			<!--Submit button to sign up user-->
			<button type="submit">Sign up</button>
		</form>

		<!--Link to send user to login page-->
		<NavLink href="/login" class="forgot">Already have an account?</NavLink>
	
	</div>

</div>

@code {
	protected override void OnInitialized() {
		invert = true;
		base.OnInitialized();
	}

	/// <summary>
	/// The email currently typed by the user.
	/// </summary>
	private string email = "";
	/// <summary>
	/// The username currently typed by the user.
	/// </summary>
	private string username = "";
	/// <summary>
	/// The password currently typed by the user.
	/// </summary>
	private string password = "";
	/// <summary>
	/// The currently displayed error message. Blank for no error.
	/// </summary>
	private string errorMessage = "";

	/// <summary>
	/// Attempts to create a new account with the currently provided email, username, and password. Redirects to home on success, displays error text on fail.
	/// </summary>
	private void SignupAttempt() {
		bool success = sessionManager.AttemptSignup(email, username, password);
		if (success) {
			navigationManager.NavigateTo("/"); // Root auto-redirects to the appropriate home based on context.
		} else {
			errorMessage = "Username already in use. Please try another username.";
		}
	}
}