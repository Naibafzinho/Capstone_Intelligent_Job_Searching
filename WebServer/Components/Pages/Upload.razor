@page "/upload"
@inherits Redirect

@inject IJSRuntime JSRuntime
@inject ResumeHandler resumeHandler
@inject SessionManager sessionManager

<PageTitle>Upload Resume</PageTitle>

<div class="upload-wrapper">

	<!--Upload Status-->
	<p class="status" style="color: @statusColor;">@status</p>

	<!--Upload Box for Resumes-->
	<div class="upload-box" id="drop-area" @ondrop=UploadResume @ondragover:preventDefault>
		<p>Drag & Drop or</p>
		<button type="button" @onclick=BrowseFiles>Browse Files</button>
		<InputFile OnChange=HandleFileSelection accept=".txt,.doc,.docx,.pdf" hidden />
		<p id="fileName">@fileName</p>
	</div>

	<!--Upload Resume button for processing-->
	<button type="button" class="uploadBtn" @onclick=UploadResume>Upload and Process</button>

</div>

@code {
	/// <summary>
	/// The currently uploaded resume file.
	/// </summary>
	private IBrowserFile? resumeFile;
	/// <summary>
	/// The currently uploaded resume filename.
	/// </summary>
	private string fileName = "";

	/// <summary>
	/// The current status message to display to user. Change via SetStatus(), not directly.
	/// </summary>
	private string status = "Select a resume file to upload (txt, doc, docx, or pdf).";
	/// <summary>
	/// The CSS color of the current status message. Change via SetStatus(), not directly.
	/// </summary>
	private string statusColor = "inherit"; // Inherit sets status text to default color.
	enum StatusType { standard, success, failure }

	/// <summary>
	/// Sets the current status text.
	/// </summary>
	/// <param name="message">The message string.</param>
	/// <param name="type">The type of message. Affects display color.</param>
	private void SetStatus(string message, StatusType type = StatusType.standard) {
		status = message;
		statusColor = type switch {
			StatusType.standard => "inherit",
			StatusType.success => "green",
			StatusType.failure => "#CC2533", // Failure red.
			_ => "inherit"
		};
	}

	/// <summary>
	/// Opens the file upload window manually via JS interop.
	/// </summary>
	private async Task BrowseFiles() {
		// TODO: Prevent user from interacting with webpage while upload window is open.
		// Open file upload popup window, filter to valid filetypes.
		await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('input[type=file]').click();");
	}

	/// <summary>
	/// Runs when the user selects a file in the upload window.
	/// </summary>
	private void HandleFileSelection(InputFileChangeEventArgs args) {
		resumeFile = args.File;
		fileName = resumeFile.Name;
		SetStatus("Resume file selected. Click \"Upload and Process\" to confirm.");
	}

	/// <summary>
	/// Attempts to upload the selected resume. Redirects to resumes on success, displays error text on fail.
	/// </summary>
	private async Task UploadResume() {
		if (resumeFile == null) return;

		SetStatus("Uploading resume...");
		try {
			// Gets resume file as raw byte stream.
			await using MemoryStream resumeBytes = new();
			await resumeFile.OpenReadStream(0x_A0_00_00).CopyToAsync(resumeBytes); // Max filesize of 10MiB. This should be plenty for any normal resume.

			// Validate filetype is TXT, DOC(X), or PDF. (This is far from perfect, but it should work well enough for now.)
			FileType fileType;
			if (Path.GetExtension(resumeFile.Name).ToLower() == ".txt") {
				fileType = FileType.text; // Check TXT files by extension due to lack of guaranteed header.
			} else {
				resumeBytes.Position = 0; // Ensures byte stream is read from the beginning.
				byte[] headerBytes = new byte[4];
				resumeBytes.Read(headerBytes, 0, headerBytes.Length); // Get the first 4 bytes of the resume file.
				fileType = headerBytes switch {
					[0x50, 0x4B, 0x03, 0x04] => FileType.docx,	// Check for DOCX file header bytes (50 4B 03 04). WARNING: THIS ALSO ACCEPTS OTHER OFFICE FILETYPES SUCH AS XLSX.
					[0xD0, 0xCF, 0x11, 0xE0] => FileType.doc,	// Check for DOC file header bytes (D0 CF 11 E0).
					[0x25, 0x50, 0x44, 0x46] => FileType.pdf,	// Check for PDF file header bytes (25 50 44 46). WARNING: THIS MAY REJECT SOME PDFS WITH GARBAGE BEFORE "%PDF".
					_ => FileType.other // Assume other filetype if extension not ".txt" and header bytes don't match DOC(X) or PDF.
				};
			}
			if (fileType == FileType.other) {
				SetStatus("Invalid filetype selected. Please upload a txt, docx, doc, or pdf file.", StatusType.failure);
				return;
			}

			// Convert byte stream into a base64 string.
			string resumeBytes64 = Convert.ToBase64String(resumeBytes.ToArray());

			// Create resume record from input data.
			string? userID = sessionManager.GetUserID();
			if (userID == null) return; // Cancel upload if somehow session is not authenticated.
			Resume resume = new(userID, null, fileName, resumeBytes64, DateTime.Today.ToString("d"), new ResumeConfig(
				IndustryPreferences: ["Banking"],
				ExperienceLevels: ["Entry-Level"],
				EmploymentType: ["Full-Time"],
				ExpectedSalaryRanges: ["$150,000 - $250,000"],
				Locations: ["Altoona, PA"],
				RemoteStatus: ["On-Ground"],
				CompanySizes: ["Medium", "Large"],
				Tags: [] // No tags.
			));

			// Sends resume bytes to ResumeUploader for API calls.
			bool success = resumeHandler.UploadResume(resume);

			if (success) {
				SetStatus("Resume uploaded successfully! Go to the Resumes page to view results or edit job search parameters.", StatusType.success);
			} else {
				SetStatus("Resume upload failed. (We apologize for this unhelpful error, but this is an early build with WIP failure handling.)", StatusType.failure);
			}
		} catch {
			SetStatus("Resume upload failed due to an exception.", StatusType.failure);
		}
	}

	enum FileType { other, text, docx, doc, pdf }
}