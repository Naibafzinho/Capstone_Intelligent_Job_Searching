@page "/upload"
@inherits Redirect

<PageTitle>Upload Resume</PageTitle>

<div class="upload-wrapper">

	<header>
		<Navbar />
	</header>

	<!--Upload Box for Resumes-->
	<div class="upload-box" id="drop-area">
		<p>Drag & Drop or</p>
		<button type="button" id="browseBtn" @onclick=BrowseFiles>Browse Files</button>
		<input type="file" id="fileInput" hidden>
		<p id="fileName"></p>
	</div>

	<!--Upload Resume button for processing-->
	<button type="button" class="uploadBtn" @onclick=UploadResume>Upload and Process</button>

	<!--Upload Status-->
	<p class="status">Status: <span id="status">In Progress</span></p>

</div>

