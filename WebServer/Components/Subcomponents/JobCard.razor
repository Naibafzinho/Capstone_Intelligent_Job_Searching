<div class="job-card">

	<!--Company and job title-->
	<div class="job-top">
		<div class="company-logo">@employerName</div>
		<div class="job-title-block">
			<h1 class="job-title">@jobTitle</h1>
			<p class="job-company">
				<NavLink href=@employerLink target="_blank">@employerName</NavLink> &nbsp;·&nbsp; Posted @postedDaysAgo
				days ago on @postOriginalSite
			</p>
		</div>

		<!--Match score percentage-->
		<div class="match-score">
			<ProgressBarCircle Fill=@matchRatio />
			<span class="match-score-label">match</span>
		</div>
	</div>

	<!--Tags for location, salary, industry, etc-->
	<div class="tags">
		<span class="tag tag-industry">@tags["field"]</span>
		<span class="tag tag-salary">@tags["salary"]</span>
		<span class="tag tag-location">📍 @tags["location"]</span>
		<span class="tag tag-type">@tags["employmentType"]</span>
		<span class="tag tag-remote">@tags["remoteStatus"]</span>
	</div>

	<hr class="divider">

	<!--Job description-->
	<p class="section-label">About the role</p>
	<p class="job-description">@description</p>

	<hr class="divider">

	<!--skills from job posting-->
	<p class="section-label">Skills</p>
	<p class="skills-note">Skills highlighted in orange are gaps based on your resume</p>
	<div class="skills">
		@foreach (string skill in skillsMatched)
		{
			<span class="skill">@skill</span>
		}
		@foreach (string skill in skillsMissing)
		{
			<span class="skill skill-missing">@skill</span>
		}
	</div>

	<div class="job-actions">
		<button class="btn btn-secondary" @onclick=SaveJob>Save job</button>
		<NavLink class="btn btn-secondary" href=@jobLink target="_blank" role="button">View original posting</NavLink>
	</div>

</div>

