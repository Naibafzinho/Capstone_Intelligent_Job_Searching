<svg viewBox="0 0 60 60" width="60" height="60">
	<!-- Background circle -->
    <circle cx="30" cy="30" r="24" fill="none" stroke="#e0e0e0" stroke-width="5" />
	<!-- Foreground progress circle -->
	<circle cx="30" cy="30" r="24" fill="none" stroke="#1a6e35" stroke-width="5" stroke-dasharray="150.8"
		stroke-dashoffset="@((1 - Fill) * 150.8)" stroke-linecap="round" transform="rotate(-90 30 30)" />
	<!-- Percentage text -->
	<text x="30" y="35" text-anchor="middle" font-size="13" font-weight="bold" fill="#111" font-family="Arial">@((int)(Fill*100))%</text>
</svg>

@code {
	[Parameter]
	public float Fill { get; set; }
}