@inject NavigationManager navigationManager
@inject ResumeHandler resumeHandler
@inject ResumeDisplayer resumeDisplayer

<div class="resumeBox">
	<div class="resume-left">
		<div class="resume-icon">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
			</svg>
		</div>
		<input type="text" class="resumeTitleInput" value=@Name>
	</div>

	<div class="resume-divider"></div>

	<div class="resume-actions">

		<!-- ANALYZE BUTTON (FIXED) -->
		<button class="btn-analysis" @onclick="AnalyzeResume">
			Analysis
		</button>

		<NavLink href="@($"/matches/{targetResumeID}")" class="btn-matches">
			Matches
		</NavLink>

		<NavLink href="/edit" class="btn-edit">
			Edit
		</NavLink>

		<button class="btn-delete" @onclick=DeleteResume>
			Delete
		</button>

	</div>
</div>

@code {
	[Parameter]
	public required string targetResumeID { get; set; }

	[Parameter]
	public required string Name { get; set; }

	private void AnalyzeResume()
	{
		navigationManager.NavigateTo($"/analysis/{targetResumeID}");
	}

	private void DeleteResume()
	{
		Resume? thisResume = resumeDisplayer.GetResumeByID(targetResumeID);
		if (thisResume == null) return;

		resumeHandler.DeleteResume(thisResume);
	}
}